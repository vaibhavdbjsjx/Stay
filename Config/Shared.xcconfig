// Stay — the ONE place to set your identifiers before shipping.
//
// 1. Replace STAY_BUNDLE_PREFIX with your reverse-DNS prefix (e.g. com.acme).
//    Everything else (bundle IDs, App Group, iCloud container) derives from it.
// 2. Set STAY_TEAM_ID to your 10-character Apple Developer Team ID.
//
// Derived identifiers:
//   App bundle ID       $(STAY_BUNDLE_PREFIX).stay
//   Widget extension    $(STAY_BUNDLE_PREFIX).stay.widget
//   App Group           group.$(STAY_BUNDLE_PREFIX).stay
//   iCloud container    iCloud.$(STAY_BUNDLE_PREFIX).stay

STAY_BUNDLE_PREFIX = com.vaibhavsg
STAY_TEAM_ID = LNL8GARN23

STAY_BUNDLE_ID = $(STAY_BUNDLE_PREFIX).stay
STAY_APP_GROUP = group.$(STAY_BUNDLE_PREFIX).stay
STAY_ICLOUD_CONTAINER = iCloud.$(STAY_BUNDLE_PREFIX).stay

// 3. Google Sign-In (optional). From Google Cloud Console → Credentials → OAuth client ID (iOS).
//    Leave empty to hide the Google button. The reversed ID is the client ID with its parts reversed,
//    e.g. com.googleusercontent.apps.1234-abcd
STAY_GOOGLE_CLIENT_ID =
STAY_GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.not-configured
